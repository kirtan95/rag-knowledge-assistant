# ---- Database ----
# SQLAlchemy URL for the pgvector-backed Postgres. In docker-compose the
# service name is `db`, so the default below just works there.
DATABASE_URL=postgresql+psycopg://rag:ragpassword@db:5432/ragdb

# ---- Generation (optional) ----
# If set, /query answers with Anthropic Claude. If unset, /query returns the
# retrieved context chunks with a notice that generation needs the key.
ANTHROPIC_API_KEY=
# Any current Claude model id, e.g. claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Chunking ----
# Target chunk size in tokens and overlap between consecutive chunks.
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---- Retrieval ----
# Default number of chunks returned per query.
TOP_K=5

# ---- Embeddings ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
